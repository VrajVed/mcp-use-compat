{
  "name": "mcpkit",
  "version": "0.3.1",
  "description": "Find the problems that break an MCP server in specific MCP clients (Claude, ChatGPT, Cursor, VS Code, Codex and more), with sourced client facts, SDK upgrade help and CI output.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "compatibility",
    "lint",
    "testing",
    "claude",
    "chatgpt",
    "cursor",
    "vscode",
    "codex",
    "ci"
  ],
  "homepage": "https://github.com/VrajVed/mcpkit#readme",
  "bugs": {
    "url": "https://github.com/VrajVed/mcpkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VrajVed/mcpkit.git"
  },
  "license": "MIT",
  "author": "VrajVed",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "mcpkit": "./dist/index.js"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p .",
    "dev": "tsc -p . --watch",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "prepack": "npm run build",
    "readme": "tsx scripts/readme.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^12.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
